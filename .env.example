# Discord bot token  (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Your server ID  (right-click server icon -> Copy Server ID, Developer Mode on)
GUILD_ID=

# How often to pull fresh trade ads (seconds). Ads cover the past 3 minutes.
POLL_INTERVAL_SECONDS=45

# Rolimon's pacing. Measured: 120 req/min sustained works with zero 429s,
# 240 req/min starts getting limited. 500ms = 120/min, the safe ceiling.
ROLIMONS_MIN_INTERVAL_MS=500
ROLIMONS_CONCURRENCY=3

# Proxies for Rolimon's requests. Comma or newline separated; each one gets its
# own independent rate budget, so 3 proxies = 3x the throughput.
#   http://user:pass@host:port
#   socks5://user:pass@host:port
# Leave empty to use the server's own IP.
ROLIMONS_PROXIES=

# How long a player's RAP/Value is cached before being recomputed (minutes).
# Longer = faster scans, since repeat players cost no API calls.
VALUE_CACHE_MINUTES=120

# Max fresh inventories to price in one scan. At 120 req/min this can go high,
# but keeping it bounded stops one busy scan starving the next.
MAX_PRICE_PER_SCAN=40

# ---- posting rhythm ----
# Each channel has its own timer: it sends one post every POST_INTERVAL_MS.
# 2000 = one per channel every 2 seconds, running forever.
POST_INTERVAL_MS=2000
# Max posts held per channel; oldest dropped past this
QUEUE_LIMIT=200

# How long before the same player can be posted again in the same channel.
# 0 = no cooldown at all, so the same players keep cycling.
POST_COOLDOWN_MINUTES=0

# ---- /notify ----
# How long before the same player can trigger the same notification again
NOTIFY_REPEAT_MINUTES=60
# Safety cap on DMs sent per scan
NOTIFY_MAX_PER_SCAN=10

# How many of their most valuable limiteds to list in each post (max 10)
TOP_ITEMS=5

# Which stat decides the bracket: both | rap | value
BUCKET_METRIC=both

# Optional: startup summary channel
STATUS_CHANNEL_ID=
