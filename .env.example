# Discord bot token  (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Your server ID  (right-click server icon -> Copy Server ID, Developer Mode on)
GUILD_ID=

# How often to pull fresh trade ads (seconds). Ads cover the past 3 minutes.
POLL_INTERVAL_SECONDS=120

# Minimum gap between requests to api.rolimons.com (they throttle above ~45/min)
ROLIMONS_MIN_INTERVAL_MS=1300

# How long a player's RAP/Value is cached before being recomputed (minutes)
VALUE_CACHE_MINUTES=60

# ---- posting rhythm ----
# How many posts to send in one channel before moving to the next one
POSTS_PER_CHANNEL=5
# Gap between two posts, in milliseconds (2000 = 2 seconds)
POST_INTERVAL_MS=2000
# Max posts held per channel; oldest are dropped past this
QUEUE_LIMIT=60

# How long before the same player can be posted in the same bracket channel (minutes)
POST_COOLDOWN_MINUTES=90

# How many of their most valuable limiteds to list in each post (max 10)
TOP_ITEMS=5

# Which stat decides the bracket: both | rap | value
BUCKET_METRIC=both

# Optional: startup summary channel
STATUS_CHANNEL_ID=
