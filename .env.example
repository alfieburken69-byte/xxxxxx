# Discord bot token  (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Your server ID  (right-click server icon -> Copy Server ID, Developer Mode on)
GUILD_ID=

# How often to pull fresh trade ads (seconds). Ads cover the past 3 minutes.
POLL_INTERVAL_SECONDS=30

# ---- Rolimon's request lanes ----
# Pacing per lane. With a rotating proxy every request is a new IP, so this can
# be aggressive; without one, 500ms (120/min) is the measured safe ceiling.
ROLIMONS_MIN_INTERVAL_MS=150
ROLIMONS_CONCURRENCY=5

# Proxies, comma or newline separated. Each is its own rate lane.
#   http://user:pass@host:port
#   socks5://user:pass@host:port
ROLIMONS_PROXIES=

# Set to 1 when the proxy rotates its exit IP per request. Disables the
# penalty-pause logic, since retrying simply lands on a different IP.
ROLIMONS_ROTATING_PROXY=0

# How long a player's RAP/Value is cached (minutes). Longer = faster scans.
VALUE_CACHE_MINUTES=120

# Max fresh inventories to price per scan.
MAX_PRICE_PER_SCAN=40

# ---- posting rhythm ----
# Each channel sends one post every POST_INTERVAL_MS, independently, forever.
POST_INTERVAL_MS=2000
QUEUE_LIMIT=200

# Minutes before the same player can repost in the same channel. 0 = never blocked.
POST_COOLDOWN_MINUTES=0

# ---- /notify ----
NOTIFY_REPEAT_MINUTES=60
NOTIFY_MAX_PER_SCAN=10

# How many of their most valuable limiteds to list per post (max 10)
TOP_ITEMS=5

# Which stat decides the bracket: both | rap | value
BUCKET_METRIC=both

# Optional: startup summary channel
STATUS_CHANNEL_ID=
